# CycloneShield AI - Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to GitHub

# --- IBM Watsonx / Granite ---
IBM_GRANITE_API_KEY=your_ibm_api_key_here
IBM_GRANITE_PROJECT_ID=your_ibm_project_id_here
IBM_GRANITE_URL=https://us-south.ml.cloud.ibm.com

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here

# --- App Settings ---
# Set to "demo" to run without real API keys (fully functional demo mode)
APP_MODE=demo

# Set your preferred primary LLM provider: granite | gemini | groq
PRIMARY_LLM_PROVIDER=groq

# --- Optional: OpenWeatherMap (for live weather data) ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
