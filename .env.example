# CycloneShield AI — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to GitHub — it is in .gitignore.

# ─────────────────────────────────────────────────────────────────────────────
# IBM watsonx.ai Credentials (REQUIRED for Live AI mode)
# ─────────────────────────────────────────────────────────────────────────────
# Model used: ibm/granite-4-h-small
# Get your credentials at:
#   API key:    cloud.ibm.com → Manage → IAM → API keys → Create
#   Project ID: us-south.dataplatform.cloud.ibm.com → Your project → Manage
IBM_GRANITE_API_KEY=your_ibm_api_key_here
IBM_GRANITE_PROJECT_ID=your_ibm_project_id_here
IBM_GRANITE_URL=https://us-south.ml.cloud.ibm.com

# ─────────────────────────────────────────────────────────────────────────────
# App Mode & Provider
# ─────────────────────────────────────────────────────────────────────────────
# Behaviour:
#   - APP_MODE=live  + PRIMARY_LLM_PROVIDER=granite → IBM Granite live (ibm/granite-4-h-small)
#   - APP_MODE=demo  OR credentials missing          → Demo mode (pre-written data)
#   - APP_MODE=live  but credentials missing         → Error (no silent demo fallback)
#
# Live AI (default when credentials are configured):
APP_MODE=live
PRIMARY_LLM_PROVIDER=granite-4-h-small
#
# To force demo even when credentials are present, change both lines to:
# APP_MODE=demo
# PRIMARY_LLM_PROVIDER=demo

# ─────────────────────────────────────────────────────────────────────────────
# Live Weather Data
# ─────────────────────────────────────────────────────────────────────────────
# Open-Meteo is used automatically (free, no key required).
# OpenWeatherMap is optional — provides additional data if key is available:
OPENWEATHER_API_KEY=your_openweather_api_key_here
