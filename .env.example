# CycloneShield AI - Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to GitHub

# --- IBM watsonx.ai (required for live AI analysis) ---
IBM_GRANITE_API_KEY=your_ibm_api_key_here
IBM_GRANITE_PROJECT_ID=your_ibm_project_id_here
IBM_GRANITE_URL=https://us-south.ml.cloud.ibm.com

# --- App Settings ---
# Set to "demo" to run without real API keys (fully functional demo mode)
APP_MODE=demo

# Set primary provider: granite (IBM watsonx.ai) is the only supported provider
PRIMARY_LLM_PROVIDER=granite

# --- Optional: OpenWeatherMap (for live weather data) ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
